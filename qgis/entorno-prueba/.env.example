# Copiar a .env para cambiar los valores del entorno de prueba de QGIS.
# Son credenciales ficticias de un entorno local; no reutilizarlas en la integración.
CLAVE_ADMIN=admin-prueba
CLAVE_PRUEBA=sigtec-prueba
CLAVE_REPLICADOR=replicador-prueba

# El central usa la base de puertos y cada campus usa base + campus_id.
PUERTO_BASE=56430
PUERTO_CARTAGO=56431
PUERTO_SAN_JOSE=56432
PUERTO_SAN_CARLOS=56433

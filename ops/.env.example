# Copiar a ops/.env y definir contraseñas locales antes de iniciar.
OPS_CENTRAL_PASSWORD=
OPS_CARTAGO_PASSWORD=
# migrate.py genera estas variables en .env si faltan o están vacías.
# Si se definen manualmente: al menos 32 caracteres aleatorios A-Z, a-z, 0-9, _ o -.
OPS_CENTRAL_CLI_PASSWORD=
OPS_CARTAGO_CLI_PASSWORD=
